{
  "name": "prime-agent-jupyterlab",
  "version": "0.2.0",
  "description": "Prime Agent chat panel for JupyterLab",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "scripts": {
    "build": "tsc -b",
    "build:prod": "tsc -b && npm run build:labextension",
    "build:labextension": "jupyter labextension build .",
    "clean": "rimraf lib prime_agent_jupyterlab/labextension",
    "watch": "tsc -b --watch"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/launcher": "^4.0.0",
    "@jupyterlab/rendermime": "^4.0.0",
    "@jupyterlab/ui-components": "^4.0.0",
    "@lumino/widgets": "^2.0.0",
    "@lumino/disposable": "^2.0.0",
    "@lumino/signaling": "^2.0.0",
    "@lumino/coreutils": "^2.0.0",
    "@lumino/messaging": "^2.0.0",
    "@lumino/domutils": "^2.0.0",
    "@lumino/algorithm": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@mui/material": "^5.14.0",
    "@mui/icons-material": "^5.14.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "clsx": "^2.0.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "rimraf": "^5.0.0"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "prime_agent_jupyterlab/labextension"
  }
}
