{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "incremental": true,
    "inlineSources": true,
    "sourceMap": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "noEmit": false,
    "outDir": "./lib",
    "preserveWatchOutput": true,
    "resolveJsonModule": true,
    "rootDir": "./src",
    "strict": true,
    "target": "ES2022",
    "jsx": "react",
    "declarationMap": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
